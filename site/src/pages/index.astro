---
const githubUrl = "https://github.com/markjaquith/cowtree";
const pageUrl = "https://markjaquith.github.io/cowtree/";
const socialImageUrl = `${pageUrl}social-card.png`;
const description =
  "Space-efficient Git worktrees on macOS using APFS copy-on-write clones.";
const assetBaseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <meta
      name="description"
      content={description}
    />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="cowtree — space-efficient Git worktrees" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="cowtree — space-efficient Git worktrees" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="cowtree — space-efficient Git worktrees" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="cowtree — space-efficient Git worktrees" />
    <title>cowtree — space-efficient Git worktrees</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">macOS + APFS + Git worktrees =</p>
        <h1>cowtree</h1>
        <p class="intro">
          Create space-efficient Git worktrees on macOS using APFS copy-on-write clones.
          Compact existing worktrees to reduce their physical storage by up to 95%.
        </p>
        <nav aria-label="Project links">
          <a class="button" href={githubUrl}>View on GitHub</a>
          <a href={`${githubUrl}#usage`}>Read the docs →</a>
        </nav>
      </header>

      <section aria-labelledby="install-heading">
        <h2 id="install-heading">Install</h2>
        <pre><code>brew install markjaquith/tap/cowtree</code></pre>
      </section>

      <section aria-labelledby="usage-heading">
        <h2 id="usage-heading">Use</h2>
        <pre><code><span class="comment"># Create a copy-on-write worktree</span>
cowtree add ../feature -b feature

<span class="comment"># Compact an existing worktree</span>
cowtree compact my-feature-branch

<span class="comment"># Compact all repo worktrees</span>
cowtree compact --all

<span class="comment"># See compaction status</span>
cowtree status --all</code></pre>
      </section>

      <section aria-labelledby="feedback-heading">
        <h2 id="feedback-heading">Feedback</h2>
        <figure class="pull-quote cow-quote">
          <div>
            <blockquote>
              <p>COW means copy-on-write. Please remove me from your mailing list.</p>
            </blockquote>
          </div>
          <img src={`${assetBaseUrl}cow.png`} alt="Illustrated Highland cow" width="112" height="103" />
        </figure>
        <figure class="pull-quote">
          <img src={`${assetBaseUrl}tree.png`} alt="Illustrated oak tree" width="92" height="105" />
          <div>
            <blockquote>
              <p>You nerds need to touch grass.</p>
            </blockquote>
          </div>
        </figure>
      </section>

      <footer>
        <p>Requires macOS and APFS. Released under the MIT License.</p>
        <p>Linux users go away &mdash; you can just use <a href="https://btrfs.readthedocs.io/en/latest/">btrfs</a>.</p>
      </footer>
    </main>

    <div class="grass" aria-hidden="true">
      <canvas></canvas>
    </div>
  </body>
</html>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".grass canvas");

  if (canvas) {
    const context = canvas.getContext("2d");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const layerSettings = [
      {
        density: 0.15,
        minHeight: 0.28,
        heightRange: 0.32,
        minWidth: 1.8,
        widthRange: 2.2,
        opacity: 0.62,
        colors: ["#47772f", "#558437", "#63913d"],
      },
      {
        density: 0.2,
        minHeight: 0.4,
        heightRange: 0.36,
        minWidth: 2.6,
        widthRange: 2.8,
        opacity: 0.82,
        colors: ["#347229", "#428531", "#55983a"],
      },
      {
        density: 0.25,
        minHeight: 0.52,
        heightRange: 0.42,
        minWidth: 3.4,
        widthRange: 3.4,
        opacity: 1,
        colors: ["#255f21", "#337329", "#428631", "#58a13d"],
      },
    ];
    let width = 0;
    let height = 0;
    let animationFrame = 0;
    let visible = true;
    let blades: ReturnType<typeof createBlades> = [];

    const random = (index: number, seed: number) => {
      const value = Math.sin(index * seed) * 10000;
      return value - Math.floor(value);
    };

    function createBlades(canvasWidth: number) {
      return layerSettings.flatMap((settings, layer) => {
        const overscan = 0.05;
        const fieldWidth = 1 + overscan * 2;
        const count = Math.ceil(canvasWidth * fieldWidth * settings.density);

        return Array.from({ length: count }, (_, index) => {
          const seedIndex = index + layer * 521;
          const depth = random(seedIndex, 78.901);

          return {
            x: -overscan + ((index + random(seedIndex, 12.345) * 0.95) / count) * fieldWidth,
            height: settings.minHeight + random(seedIndex, 23.456) * settings.heightRange,
            width: settings.minWidth + depth * settings.widthRange,
            depth,
            layer,
            opacity: settings.opacity,
            phaseJitter: (random(seedIndex, 42.813) - 0.5) * 1.1,
            color:
              settings.colors[
                Math.min(settings.colors.length - 1, Math.floor(depth * settings.colors.length))
              ],
          };
        }).sort((a, b) => a.depth - b.depth);
      });
    }

    const resize = () => {
      if (!context) return;

      const bounds = canvas.getBoundingClientRect();
      const scale = Math.min(window.devicePixelRatio || 1, 2);
      width = bounds.width;
      height = bounds.height;
      blades = createBlades(width);
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      context.setTransform(scale, 0, 0, scale, 0, 0);
      draw(0);
    };

    const draw = (time: number) => {
      if (!context) return;

      context.clearRect(0, 0, width, height);

      const seconds = time / 1000;
      const gust =
        0.48 + Math.sin(seconds * 0.42) * 0.16 + Math.sin(seconds * 0.17 + 2) * 0.12;

      for (const blade of blades) {
        const bladeHeight = height * blade.height * (0.86 + blade.depth * 0.14);
        const baseX = blade.x * width;
        const baseY = height + 4;
        const travelingWave = Math.sin(
          seconds * (1.12 + blade.layer * 0.13) -
            blade.x * Math.PI * 5.5 +
            blade.phaseJitter,
        );
        const fineRipple = Math.sin(seconds * 2.15 - blade.x * Math.PI * 10 + blade.phaseJitter);
        const wave = reducedMotion.matches
          ? bladeHeight * (0.07 + Math.sin(blade.x * Math.PI * 5) * 0.025)
          : bladeHeight *
            (0.045 +
              gust * (0.12 + blade.layer * 0.015) +
              travelingWave * (0.035 + gust * 0.07) +
              fineRipple * 0.018);
        const halfWidth = blade.width / 2;

        context.beginPath();
        context.moveTo(baseX - halfWidth, baseY);
        context.bezierCurveTo(
          baseX - halfWidth * 0.8,
          baseY - bladeHeight * 0.4,
          baseX + wave * 0.35 - halfWidth * 0.35,
          baseY - bladeHeight * 0.76,
          baseX + wave,
          baseY - bladeHeight,
        );
        context.bezierCurveTo(
          baseX + wave * 0.35 + halfWidth * 0.2,
          baseY - bladeHeight * 0.74,
          baseX + halfWidth * 0.8,
          baseY - bladeHeight * 0.38,
          baseX + halfWidth,
          baseY,
        );
        context.closePath();
        context.globalAlpha = blade.opacity * (0.82 + blade.depth * 0.18);
        context.fillStyle = blade.color;
        context.fill();
      }
      context.globalAlpha = 1;
    };

    const animate = (time: number) => {
      draw(time);
      if (visible && !reducedMotion.matches) {
        animationFrame = requestAnimationFrame(animate);
      }
    };

    const updateAnimation = () => {
      cancelAnimationFrame(animationFrame);
      draw(0);
      if (visible && !reducedMotion.matches) {
        animationFrame = requestAnimationFrame(animate);
      }
    };

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updateAnimation();
    }).observe(canvas);
    reducedMotion.addEventListener("change", updateAnimation);
  }
</script>

<style>
  :root {
    color-scheme: light;
    font-family:
      "Figtree", ui-sans-serif, system-ui, -apple-system, sans-serif;
    color: #1e2920;
    background: #f5f3e9;
  }

  * {
    box-sizing: border-box;
  }

  body {
    display: flex;
    min-height: 100vh;
    margin: 0;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: min(100% - 2rem, 46rem);
    margin: 0 auto;
    padding: 6rem 0 3rem;
  }

  header {
    padding-bottom: 4rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #507455;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: "Figtree", ui-sans-serif, sans-serif;
    font-size: clamp(3.5rem, 14vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .intro {
    max-width: 42rem;
    margin: 1.75rem 0;
    color: #445148;
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    line-height: 1.55;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  a {
    color: #24572d;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .button {
    padding: 0.75rem 1rem;
    border-radius: 0.35rem;
    color: #fff;
    background: #24572d;
    text-decoration: none;
  }

  section {
    margin-bottom: 3rem;
  }

  h2 {
    margin: 0 0 0.8rem;
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  pre {
    margin: 0;
    padding: 1.25rem;
    overflow-x: auto;
    border: 1px solid #ced3c8;
    border-radius: 0.5rem;
    color: #e8f1e5;
    background: #1e2920;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .comment {
    color: #9fb0a0;
  }

  .pull-quote {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.5rem;
    margin: 2rem 0 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid #507455;
    background: #ebe9dd;
  }

  .pull-quote img {
    flex: 0 0 auto;
    object-fit: contain;
  }

  .pull-quote blockquote {
    margin: 0;
  }

  .cow-quote {
    grid-template-columns: 1fr auto;
  }

  .pull-quote p {
    margin: 0;
    color: #2f3d33;
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .pull-quote p::before {
    content: "“";
  }

  .pull-quote p::after {
    content: "”";
  }

  footer {
    padding-top: 1rem;
    border-top: 1px solid #ced3c8;
    color: #677069;
    font-size: 0.9rem;
  }

  .grass {
    width: 100%;
    height: clamp(9rem, 18vw, 13rem);
    margin-top: -0.75rem;
    overflow: hidden;
    pointer-events: none;
  }

  .grass canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 34rem) {
    main {
      padding-top: 3.5rem;
    }

    .pull-quote {
      gap: 1rem;
      padding: 1rem;
    }

    .pull-quote img {
      width: 72px;
      height: auto;
    }

    nav {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
