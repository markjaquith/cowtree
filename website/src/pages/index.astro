---
const githubUrl = "https://github.com/markjaquith/cowtree";
const pageUrl = "https://markjaquith.github.io/cowtree/";
const socialImageUrl = `${pageUrl}social-card.png`;
const description =
  "Space-efficient Git worktrees on macOS using APFS copy-on-write clones.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={description}
    />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="cowtree — space-efficient Git worktrees" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="cowtree — space-efficient Git worktrees" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="cowtree — space-efficient Git worktrees" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="cowtree — space-efficient Git worktrees" />
    <title>cowtree — space-efficient Git worktrees</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">macOS + APFS + Git worktrees =</p>
        <h1>cowtree</h1>
        <p class="intro">
          Create space-efficient Git worktrees on macOS using APFS copy-on-write clones.
          Compact existing worktrees to reduce their physical storage by up to 95%.
        </p>
        <nav aria-label="Project links">
          <a class="button" href={githubUrl}>View on GitHub</a>
          <a href={`${githubUrl}#usage`}>Read the docs →</a>
        </nav>
      </header>

      <section aria-labelledby="install-heading">
        <h2 id="install-heading">Install</h2>
        <pre><code>brew install markjaquith/tap/cowtree</code></pre>
      </section>

      <section aria-labelledby="usage-heading">
        <h2 id="usage-heading">Use</h2>
        <pre><code><span class="comment"># Create a copy-on-write worktree</span>
cowtree add ../feature -b feature

<span class="comment"># Compact an existing worktree</span>
cowtree compact my-feature-branch

<span class="comment"># Compact all repo worktrees</span>
cowtree compact --all

<span class="comment"># See compaction status</span>
cowtree status --all</code></pre>
      </section>

      <footer>
        <p>Requires macOS and APFS. Released under the MIT License.</p>
        <p>Linux users go away &mdash; you can just use <a href="https://btrfs.readthedocs.io/en/latest/">btrfs</a>.</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #1e2920;
    background: #f5f3e9;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  main {
    width: min(100% - 2rem, 46rem);
    margin: 0 auto;
    padding: 6rem 0 3rem;
  }

  header {
    padding-bottom: 4rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #507455;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(3.5rem, 14vw, 7rem);
    letter-spacing: -0.08em;
    line-height: 0.95;
  }

  .intro {
    max-width: 42rem;
    margin: 1.75rem 0;
    color: #445148;
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    line-height: 1.55;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  a {
    color: #24572d;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .button {
    padding: 0.75rem 1rem;
    border-radius: 0.35rem;
    color: #fff;
    background: #24572d;
    text-decoration: none;
  }

  section {
    margin-bottom: 3rem;
  }

  h2 {
    margin: 0 0 0.8rem;
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  pre {
    margin: 0;
    padding: 1.25rem;
    overflow-x: auto;
    border: 1px solid #ced3c8;
    border-radius: 0.5rem;
    color: #e8f1e5;
    background: #1e2920;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .comment {
    color: #9fb0a0;
  }

  footer {
    padding-top: 1rem;
    border-top: 1px solid #ced3c8;
    color: #677069;
    font-size: 0.9rem;
  }

  @media (max-width: 34rem) {
    main {
      padding-top: 3.5rem;
    }

    nav {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
